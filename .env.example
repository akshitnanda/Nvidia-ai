# Leave empty for local demo mode. Required for live NVIDIA serverless calls.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LOCAL_NIM_BASE_URL=http://localhost:8000/v1
# Supported modes: serverless, local_nim, demo
NVIDIA_PROVIDER_MODE=serverless
SWARM_CONFIG_DIR=config
SWARM_DATA_DIR=data
SWARM_LOG_LEVEL=INFO
SWARM_DEFAULT_TEST_COMMAND=pytest -q
SWARM_DEFAULT_LINT_COMMAND=python -m compileall app tests
SWARM_AUTO_APPLY=false
SWARM_MAX_FILE_BYTES=200000
SWARM_MAX_FOCUSED_FILES=8
SWARM_MAX_CONTEXT_BYTES=80000
# Managed jobs: per-request limits cannot exceed these operator caps.
SWARM_JOB_CONCURRENCY=2
SWARM_JOB_MAX_SECONDS=1800
SWARM_JOB_MAX_CALLS=48
SWARM_JOB_MAX_TOKENS=500000
